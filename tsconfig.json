{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": ".", "outDir": "dist", "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "declaration": true,
    "sourceMap": true, "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022"], "types": ["node"]
  },
  "include": ["packages/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["dist", "node_modules", "fixtures"]
}
